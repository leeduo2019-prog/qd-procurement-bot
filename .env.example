# 钉钉推送配置
# 请复制此文件为 .env 并填写真实配置

# 钉钉群机器人 Webhook 地址
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN

# 钉钉加签密钥（推荐配置，增强安全性）
DINGTALK_SECRET=SECxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 请求超时时间（秒）
DINGTALK_TIMEOUT=10

# 爬虫配置
# 关键词列表，标题包含这些词的公告会被筛选
KEYWORDS=造价，审计，预算，决算，结算

# 运行模式：daily（每天运行）, once（一次性运行）
RUN_MODE=daily

# 区域类型：all（全部）, qingdao（仅青岛市）, districts（仅各区市）
AREA_TYPE=all
